{
  "schemaVersion": 1,
  "baseRepository": "workloom-ai/workloom-im",
  "releasePolicy": "base-first-stable-only",
  "ui": {
    "package": "@workloom/ui",
    "contractVersion": "2.0.0",
    "candidateVersion": "0.1.5",
    "latestStableVersion": "0.1.5",
    "requiredClientPackages": [
      "apps/web/package.json",
      "apps/webb/package.json",
      "apps/webc/package.json"
    ],
    "allowedIndustryOverrides": [
      "--wl-brand-primary",
      "--wl-brand-on-primary",
      "--wl-brand-accent"
    ],
    "sourceDirectory": "packages/ui",
    "distribution": {
      "type": "github-release-tarball",
      "urlTemplate": "https://cnb.cool/workloom-ai/workloom-im/-/releases/download/ui-v{version}/workloom-ui-{version}.tgz",
      "assetNameTemplate": "workloom-ui-{version}.tgz",
      "integrityByVersion": {
        "0.1.0": "sha512-0O2dJkxvzNoRQcnVH6v8o7qyWW/yYmImrNhaaUWqR/FgovwJI3sHzugAaa4mHeCERWeMihxCRX/jIY93WHW8Vw==",
        "0.1.1": "sha512-7OXEtRNRknpkd5VTb6SX4j7SZQ1cE1QGHqay7EDNpW40EXuyvJiC5wI6YLTZ4GleFP6lKKItbCLTjoc1SeTrAw==",
        "0.1.2": "sha512-WAIB3xtbV32T2x7C88eA7z3/pRqY8fOHvS9ce6yMbyqGCsae1xNcF4dWr88T4DWHe/9R+qPjkgZMCw1z//rLgw==",
        "0.1.3": "sha512-WKueOZJmP6eMhRljrq6vh45hy0ySsf+L3KIzl1L26bIi/gl2HA94/DoCad938zf2/06/R8y2fPXvjhFy0wnEEg==",
        "0.1.4": "sha512-aUVu65XAxife5b3WcxO0S99o6sK4g1NrlI8kiZ/RCeSqvGLWUflUeKMnMjSuHM/sBbIpRB15wqoI2x9CDkoCoA=="
      },
      "comment": "2026-09-17 起 @workloom/ui 制品托管在 CNB Release（cnb.cool/workloom-ai/workloom-im），替代已失效的 GitHub Release tarball；type 枚举保留历史值以兼容各仓 state。"
    }
  },
  "clientFoundation": {
    "schemaVersion": "workloom.client-foundation/v1",
    "stateFile": ".workloom-client-foundation.json",
    "candidateVersion": "0.1.5",
    "latestStableVersion": "0.1.5",
    "stableSourceRefPattern": "refs/tags/ui-v{version}",
    "distribution": "stable-tag-upgrade-pr",
    "maxManagedFiles": 500,
    "managedRoots": [
      "apps/web",
      "apps/webb",
      "apps/webc"
    ],
    "requiredEntries": [
      "apps/web/src/main.tsx",
      "apps/webb/src/main.tsx",
      "apps/webc/src/main.tsx",
      "apps/webc/public/service-front.config.json"
    ],
    "allowedIndustryExtensionPaths": [
      "apps/*/src/extensions/**",
      "apps/*/src/projections/**",
      "apps/*/src/config/industry/**",
      "apps/*/src/theme/industry/**",
      "apps/*/public/industry/**"
    ],
    "ignoredRuntimePaths": [
      "apps/*/dist/**",
      "apps/*/node_modules/**",
      "apps/*/.vite/**",
      "apps/*/.DS_Store"
    ],
    "protectedRootFiles": [
      "product.manifest.json",
      "electron-builder.yml"
    ]
  }
}
