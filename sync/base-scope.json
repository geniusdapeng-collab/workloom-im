{
  "version": 4,
  "description": "WorkLoom IM 基座能力同步范围声明——base-sync 引擎的唯一事实源。文件型公共能力按 include/exclude 受控分发；三端组件与视觉语言只通过 @workloom/ui 稳定制品升级 PR 下发。行业属性与演示能力永不同步。requiredRootAssets 无视行业代码的 pathPrefix，始终安装并校验在 Git 仓库根目录。修改本文件即修改同步边界，需基座 owner 评审。",

  "registryCapabilities": [
    {
      "package": "@workloom/ui",
      "source": "packages/ui/**",
      "consumers": ["apps/web", "apps/webb", "apps/webc"],
      "distribution": "stable-registry-upgrade-pr",
      "consumerGate": "scripts/verify-ui-consumer.mjs",
      "migration": "two-phase-required",
      "comment": "第一阶段先补齐三个真实生产客户端与产品身份配置，第二阶段再锁定稳定制品并运行消费门禁；缺少 apps/webb 等客户端时必须报告迁移未完成，禁止按三端合规处理。"
    }
  ],

  "protectedChildAssets": {
    "files": [
      "electron-builder.yml",
      "product.manifest.json"
    ],
    "identityFields": [
      "appId",
      "productName",
      "ports",
      "publish"
    ],
    "comment": "桌面应用标识、产品名、端口和发布身份属于部署实例资产；base-sync 不得整文件覆盖。新行业应由 product.manifest.json 显式配置，存量仓先完成身份迁移再接收稳定基座升级。"
  },

  "requiredRootAssets": {
    "files": [
      "WORKLOOM_PRODUCT_CONTEXT.md"
    ],
    "copiedFiles": {
      ".github/workflows/base-sync-heartbeat.yml": {
        "source": "sync/heartbeat-template.yml"
      }
    },
    "managedSections": {
      "AGENTS.md": {
        "beginMarker": "<!-- WORKLOOM-CONTEXT:BEGIN -->",
        "endMarker": "<!-- WORKLOOM-CONTEXT:END -->",
        "missingFilePrefix": "# WorkLoom 仓库开发指引\n\n> 本文件包含 WorkLoom 各仓共享的受控规则；仓库专属规则位于 AGENTS.repo.md 或更近层级的 AGENTS.md / AGENTS.override.md。共享规则由 workloom-im 统一维护和分发。",
        "missingFileSuffix": "## 本仓专属规则\n\n请把本仓独有的职责、命令、验证要求与例外写入根级 AGENTS.repo.md 或更近层级的 AGENTS.md / AGENTS.override.md；不得修改上方受控区块来放宽公共安全不变量。",
        "replaceWholeFileSha256": [
          "72f6c5c7f636f8a507ec2b7d4db40e7bdaf4e2dcfab0ea2fdb57c07bb13b8e5d"
        ],
        "legacyGitBlobOids": [
          "6fbce152b7a9439ebac5829061b75f754913b882"
        ]
      }
    },
    "comment": "copiedFiles 与 files 均整文件验真；AGENTS.md 只按受控区块合并。legacyGitBlobOids 仅供审计，迁移判定只使用逐字节 SHA-256 allowlist。"
  },

  "preCommitSecretScanner": "scripts/secret-scan.mjs",

  "adoptMigrations": {
    "AGENTS.repo.md": {
      "strategy": "replace-if-identical-to-base",
      "scaffold": "# 本仓专属开发规则\n\n> 本文件用于补充当前行业仓独有的职责、命令、验证要求与例外。请结合本仓实际内容填写；共享产品认知与安全不变量由根级 AGENTS.md 的受控区块继承。\n"
    },
    ".github/workflows/base-sync-push.yml": {
      "strategy": "remove-if-identical-to-base"
    }
  },

  "include": [
    "packages/base/**",
    "packages/industry-contract/**",
    "packages/runtime/**",
    "packages/shared/**",
    "packages/db/**",
    "apps/server/src/**",
    "apps/server/package.json",
    "apps/desktop/**",
    "apps/web/src/lib/**",
    "apps/web/package.json",
    "scripts/**",
    "docker-compose.yml"
  ],

  "exclude": [
    "bundles/**",
    "demo/**",
    "docs/**",
    "mock/**",
    "vendor/**",
    "design-system/**",
    "apps/site/**",
    "apps/webb/**",
    "apps/webc/**",

    "electron-builder.yml",
    "product.manifest.json",

    "apps/web/src/App.tsx",
    "apps/web/src/shell/**",
    "apps/web/src/pages/**",
    "apps/web/src/components/**",
    "apps/web/src/styles/**",
    "apps/web/src/audio/**",
    "apps/web/src/voice/**",
    "apps/web/index.html",
    "apps/web/public/**",
    "apps/web/src/lib/display.ts",
    "apps/web/src/lib/demo-conversation.ts",

    "apps/server/src/trpc/router.ts",
    "apps/server/src/service/router.ts",
    "apps/server/src/service/dialog.ts",
    "apps/server/src/service/kb.ts",
    "apps/server/src/service/store.ts",
    "apps/server/src/service/gateway.ts",
    "apps/server/src/service/ticket.ts",
    "apps/server/src/service/adapters/**",
    "apps/server/src/industry/**",

    "packages/base/captain/charter.ts",
    "packages/base/captain/decision.ts",
    "packages/base/captain/loop.ts",
    "packages/base/captain/board.ts",
    "packages/base/captain/captain.test.ts",
    "packages/base/tenancy/auth.ts",
    "packages/base/bundles/assembly.ts",
    "packages/base/bundles/bundles.test.ts",
    "packages/base/bundles/segment.ts",

    "packages/db/src/schema.ts",
    "packages/db/migrations/**",

    "apps/desktop/WorkLoom.app/**",

    "skills/**",

    "scripts/seed*.ts",
    "scripts/demo.ts",
    "scripts/reset.sh",
    "scripts/simulate-twin.ts",
    "scripts/snapshot-twin.sh",
    "scripts/restore-twin.sh",
    "scripts/twin-genie.ts",
    "scripts/audit-scan.ts",
    "scripts/hardcode-scan.mjs",
    "scripts/pack-macos.sh",
    "scripts/install-im-channels.sh",
    "scripts/skill-forge.mts",
    "scripts/skill-dist-demo.mts",
    "scripts/build-sales-pptx.py",
    "scripts/eval/report/**",

    "package.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".ai-prompt",
    ".env*",
    "README*",
    "CHANGELOG.md",
    "LICENSE",
    "oss-components.json",
    ".oss-watch-state.json",
    "core.*",
    "PREVIEW_CHECKLIST.md",

    ".github/workflows/**",
    "sync/**"
  ],

  "anchorMerge": {
    "packages/base/package.json": {
      "strategy": "json-merge-keep-child-extra",
      "mergeKeys": ["exports", "dependencies", "devDependencies"],
      "comment": "基座版为底；子仓独有的 exports（如 asset-cms/publish-rpa 等行业模块）与依赖必须保留——2026-09-05 八仓对齐时整体覆盖曾致 ERR_PACKAGE_PATH_NOT_EXPORTED 服务瘫痪"
    },
    "packages/base/tsconfig.json": {
      "strategy": "json-merge-keep-child-extra",
      "mergeKeys": ["include"],
      "comment": "基座版为底；子仓独有的 include 目录（如 audit-core 试验田）必须保留"
    },
    "apps/web/package.json": {
      "strategy": "json-merge-keep-child-extra",
      "mergeKeys": ["dependencies", "devDependencies"],
      "ignoreDependencyKeys": ["@workloom/ui"],
      "comment": "基座版为底；子仓独有依赖保留。@workloom/ui 不由源码同步写入，必须经稳定版本升级 PR 更新"
    },
    "apps/server/package.json": {
      "strategy": "json-merge-keep-child-extra",
      "mergeKeys": ["dependencies", "devDependencies"],
      "comment": "基座版为底；子仓独有依赖（如 segment 接线需要的 yaml）保留"
    }
  },

  "appendOnlyDirs": [],

  "pollutionGuard": {
    "pathBlacklist": [
      "^bundles/",
      "^demo/",
      "^docs/demo",
      "^scripts/seed",
      "^scripts/demo",
      "hotel-baseline",
      "ai-pm",
      "yunqi",
      "ecommerce",
      "panda-cineforge",
      "platform-ops"
    ],
    "blacklistNote": "以 ^ 开头=路径前缀匹配；其余=子串匹配。^bundles/ 只锚定仓库根的行业包目录，不误伤 packages/base/bundles（基座 bundle 加载器）",
    "maxFilesPerSync": 200,
    "comment": "推送前硬校验：待同步文件路径命中黑名单或数量超限即中止——宁可漏报不可污染"
  }
}
