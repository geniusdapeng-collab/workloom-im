      "experimentPaths": [
        "apps/web/src/components/hud/**",
        "apps/web/src/components/star-ring/**",
        "apps/web/src/pages/p0/**"
      ],
      "industryExtensionPaths": [
        "apps/*/src/components/hud/**",
