# ============ 数据库（docker-compose 默认口径） ============
DATABASE_URL=postgres://postgres:workloom@localhost:5432/workloom
# 应用双角色（A3：旁路直写防控——只有 gateway 角色可 INSERT biz_events）
APP_DB_PASSWORD=workloom_dev_app
GATEWAY_DB_PASSWORD=workloom_dev_gateway
DATABASE_APP_URL=postgres://workloom_app:workloom_dev_app@localhost:5432/workloom
DATABASE_GATEWAY_URL=postgres://workloom_gateway:workloom_dev_gateway@localhost:5432/workloom

# ============ LLM（可选；默认 mock，离线可跑通全流程） ============
# mock | deepseek | moonshot | zhipu | openai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============ IM 通道（B11/D14；默认 mock，无凭据全流程可跑——与 LLM 同纪律） ============
# mock | dsh-im（真实通道凭据在 dsh 设置页配置：bash scripts/install-im-channels.sh 后 dsh web → IM机器人）
IM_DRIVER=mock

# ============ 演示身份 JWT（B5） ============
# 生产（NODE_ENV=production）必配：缺失直接拒启；<32 字符启动告警（熵不足）
# 生成建议：openssl rand -hex 32
JWT_SECRET=workloom-dev-secret-change-me
# 可选覆盖；默认从受保护的 product.manifest.json.productId 派生，生产缺二者则拒启。
# JWT_ISSUER=workloom-im

# ============ 行业包发布签名（仅稳定发布/生产装载） ============
# 发布流水线使用签名密钥封装稳定 Bundle；生产运行时通过密钥编号映射验证。
# 签名密钥只能保存在 CI/部署密钥库，不得提交到仓库或客户端制品。
# Bundle 稳定制品使用 Ed25519：发布环境只持私钥；自包含安装包只携公钥环。
# BUNDLE_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# BUNDLE_SIGNING_KEY_ID=workloom-release-v1
# 托管部署必须从可信配置注入公钥，或用 BUNDLE_TRUST_PATH 指向 bundles/ 之外的只读公钥环。
# 桌面安装包由启动器读取独立、受应用签名保护的 bundle-trust.json；运行时绝不信任 Bundle 同目录文件。
# BUNDLE_VERIFICATION_KEYS={"workloom-release-v1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
# BUNDLE_TRUST_PATH=/etc/workloom/bundle-trust.json

# ============ PII 脱敏盐（M2-PII；生产必配） ============
# 占位符 HMAC-SHA256 盐（workdata/pii.ts，防彩虹表反推明文）；生产必须注入，变更后新旧占位符不可关联
PII_SALT=workloom-dev-pii-salt

# ============ 服务端口 ============
SERVER_PORT=8787
WEB_PORT=5173

# ============ 织球 LoomBall（AI 班组状态表情球，T-2026-0926-0001 公共化） ============
# 1=开（默认，不配即开）；0=全部回退为既有静态形象（名册状态点 / 织伴海报球 / 线程状态点）
# 关掉即零运行时副作用：不创建实例、不注册自定义表情、不挂 pointermove 监听、不启动 rAF
# （引擎模块本身仍随包加载——它是零依赖的纯数据 + IIFE；如需从产物里也去掉，要另行改为动态 import）
# 注意：Vite 三端只从**进程环境**读 VITE_*（apps/*/ 目录下没有 .env）：
#       VITE_LOOMBALL=0 pnpm -C apps/web build   /   VITE_LOOMBALL=0 pnpm dev
VITE_LOOMBALL=1

# ============ C 端公开服务网关（必须显式绑定工作区） ============
# 部署后的客户可访问地址。单工作区可配全局地址；多工作区应按工作区 ID 显式映射。
# 未配置时仅在本地已构建 C 端的情况下返回本机预览地址，绝不会宣告正式发布。
# SERVICE_C_PUBLIC_URL=https://service.example.com/
# 全局地址采用多站点路由时，必须同时声明该地址内 C 端配置使用的站点标识。
# SERVICE_C_PUBLIC_WORKSPACE_KEY=default
# 多站点地址映射的 workspaceKey 必须精确命中下方 SERVICE_C_WORKSPACE_MAP，不能只证明工作区“存在于某个映射中”。
# SERVICE_C_PUBLIC_URL_MAP={"ws-aipm-demo":{"url":"https://service.example.com/ai-pm/","workspaceKey":"default"},"ws-partner":{"url":"https://service.example.com/partner/","workspaceKey":"partner-site"}}
# 反向代理对外暴露服务端内置 C 端资源时可配置；本地默认按 SERVER_PORT 推导。
# SERVER_PUBLIC_ORIGIN=https://gateway.example.com
# 单站点部署：直接指定唯一工作区；基座 AI 产品经理示例种子使用 ws-aipm-demo。
SERVICE_C_WORKSPACE_ID=ws-aipm-demo
# 多站点部署：不设置上项，改用服务端可信 JSON 映射；键对应前端配置的 workspaceKey。
# SERVICE_C_WORKSPACE_MAP={"default":"ws-aipm-demo","partner-site":"ws-partner"}
# H5 匿名设备直登仅供演示；生产必须 false。正式 H5 只接受身份网关签发的短期 entry_token，
# token 内签名绑定 workspaceKey、appId 与自然人 subject，客户端字段不能覆盖这些声明。
SERVICE_C_DEMO_AUTH=true
# 生产必须使用至少 32 字符高强度随机密钥。
SERVICE_C_SECRET=workloom-c-dev-secret-change-me
# H5 入口必须与 C 会话使用不同密钥；生产短于 32 字符会失败关闭。
# SERVICE_C_H5_ENTRY_SECRET=
# 受信身份提供方稳定标识（如企业统一登录、已评审的 OAuth 网关）；不得填写临时页面名称。
# SERVICE_C_H5_IDENTITY_PROVIDER=
# 身份提供方、回调域名、退出及设备迁移完成真实联调验收后才可设为 true；否则发布页保持阻断/部分就绪。
# SERVICE_C_H5_IDENTITY_PROVIDER_READY=false
# 小程序渠道凭据（未配置时接口明确返回 503，不回退为假登录）。
# SERVICE_C_WECHAT_APPID=
# SERVICE_C_WECHAT_SECRET=
# SERVICE_C_ALIPAY_APPID=
# SERVICE_C_ALIPAY_KEY=

# ============ 桌面端首启种子脚本（按仓配置；不在 base-sync 同步范围，各仓自定） ============
# workloom-im 基座出厂示例：AI 产品经理包（seed-aipm.ts → bundles/ai-pm）
# 行业版子仓改为自己行业包的种子脚本（如 workloom-hotel → scripts/seed.ts）
DESKTOP_SEED_SCRIPT=scripts/seed-aipm.ts

# ---- 事件总线（P0-3 持久化适配器）----
# EVENT_BUS=memory|nats|redis；缺省自动（内嵌 NATS 优先，缺失降级 memory）
# 桌面自包含包：启动器拉起内嵌 nats-server 后自动注入 EVENT_BUS=nats + EVENT_BUS_URL
# EVENT_BUS=
# EVENT_BUS_URL=nats://127.0.0.1:4222

# ---- 账号体系（客户域/伙伴域）----
# 短信通道 seam：未配置时失败关闭；本地演示须显式设为 dev，生产禁止 dev
ACCOUNTS_SMS_DRIVER=dev
# 兼容旧变量 SMS_PROVIDER；aliyun/tencent 需先安装对应真实适配器，不能只填名称
# SMS_PROVIDER=dev|aliyun|tencent
# SMS_ACCESS_KEY=
# 微信扫码登录 seam：接入微信开放平台后启用（未配置时登录页显示「即将开放」）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
