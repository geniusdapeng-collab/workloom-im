{
  "name": "workloom-im",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@workloom/base": "workspace:*",
    "@workloom/runtime": "workspace:*",
    "@workloom/shared": "workspace:*",
    "pg": "8.23.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev-note.js && concurrently -k -n server,web \"pnpm -C apps/server dev\" \"pnpm -C apps/web dev\"",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "BUNDLE_DIR=bundles/hotel tsx --env-file=.env scripts/seed.ts",
    "demo": "TOOL_UNVERIFIED_RATE=0 tsx --env-file=.env scripts/demo.ts",
    "doctor": "bash scripts/doctor.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:reset-safety && pnpm test:desktop-bootstrap && pnpm -r --if-present test",
    "test:reset-safety": "node --test scripts/reset-safety.test.mjs",
    "test:desktop-bootstrap": "node --test apps/desktop/electron/bootstrap.test.cjs scripts/desktop-bootstrap-db.test.mjs",
    "db:verify-chain": "tsx --env-file=.env scripts/verify-chain.ts",
    "suite": "TOOL_UNVERIFIED_RATE=0 tsx --env-file=.env scripts/suite.ts",
    "release:gate": "tsx --env-file=.env scripts/release-gate.ts",
    "agent:tour": "bash scripts/agent-tour.sh",
    "preview:all": "bash scripts/preview-all.sh",
    "capabilities": "node scripts/generate-capabilities.mjs",
    "capabilities:check": "node scripts/generate-capabilities.mjs --check",
    "product:verify": "node scripts/verify-product-content.mjs",
    "bundle:governance": "tsx scripts/bundle-governance.mts",
    "bundle:governance:test": "vitest run scripts/bundle-governance.test.ts",
    "bundle:seal": "tsx scripts/bundle-governance.mts --refresh-digests",
    "bundle:release": "tsx scripts/bundle-governance.mts --refresh-digests --release",
    "projections:generate": "tsx scripts/generate-client-projections.mts --write",
    "projections:check": "tsx scripts/generate-client-projections.mts",
    "ui:governance": "node --test scripts/ui-governance-rules.test.mjs && node scripts/verify-ui-governance.mjs",
    "ui:governance:test": "node --test scripts/ui-governance-rules.test.mjs",
    "ui:e2e": "playwright test",
    "ui:e2e:update": "playwright test --update-snapshots",
    "pc-shell:verify": "node scripts/verify-pc-shell.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs --files AGENTS.md AGENTS.repo.md WORKLOOM_PRODUCT_CONTEXT.md",
    "secrets:scan:staged": "node scripts/secret-scan.mjs --staged",
    "capabilities:pptx": "python3 scripts/build-capability-pptx.py",
    "postinstall": "pnpm -C packages/ui build && pnpm -C packages/industry-contract build && (node scripts/postinstall-note.js || true)",
    "oss:watch": "bash scripts/oss-watch.sh",
    "oss:plan": "bash scripts/oss-watch.sh --show",
    "db:seed:boost": "tsx --env-file=.env scripts/seed-boost.ts",
    "computer": "tsx packages/base/computer-use/cli.ts",
    "computer:preflight": "bash packages/base/computer-use/toolkit/preflight_check.sh",
    "computer:start": "bash packages/base/computer-use/toolkit/start_desktop.sh",
    "computer:stop": "bash packages/base/computer-use/toolkit/stop_desktop.sh",
    "computer:serve": "tsx packages/base/computer-use/serve.ts",
    "computer:mcp": "tsx packages/base/computer-use/mcp.ts",
    "computer:smoke": "tsx packages/base/computer-use/smoke.ts",
    "setup": "bash scripts/bootstrap.sh",
    "setup:full": "bash scripts/bootstrap.sh --with-computer",
    "skill:forge": "tsx scripts/skill-forge.mts",
    "app": "tsx scripts/desktop-app.mts",
    "app:dev": "tsx scripts/desktop-app.mts --dev",
    "app:pack": "electron-builder --dir",
    "app:dist": "electron-builder",
    "setup:lite": "tsx scripts/setup-lite.mts",
    "db:seed:aipm": "tsx --env-file=.env scripts/seed-aipm.ts",
    "db:seed:aipm:verify-idempotence": "tsx --env-file=.env scripts/verify-seed-aipm-idempotence.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-governance": "npm:typescript@5.9.3",
    "yaml-governance": "npm:yaml@2.9.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  },
  "description": "WorkLoom IM · 企业级 Agent IM 底座（智能班组 + 围栏 + 人审 + 夜班）"
}
