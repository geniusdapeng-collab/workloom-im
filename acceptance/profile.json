        "id": "LLM-R1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "内置模型 · 推理任务（dsh harness + 围栏 + 账本）",
        "prompt": "背景：演示工作区收到一条模糊需求「把产品做得更好用」。请给出：① 你要先澄清的 3 个问题 ② 你会派给哪个岗位 ③ 一条可执行的第一步动作与风险。要求：先结论后依据，最后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "澄清|岗位|委派|风险|需求"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-T1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "内置模型 · 工具循环（工具调用过围栏瀑布 + 事件落哈希链）",
        "prompt": "请调用 bash 工具执行 `echo workloom-live`，把命令输出原样贴出来，然后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "workloom-live|TASK_COMPLETE"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-M1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P1",
        "fixture": "auto",
        "title": "内置模型 · 多模态理解（截图/夹具图到达模型）",
        "prompt": "请打开随附图片，用一句话说明图中主体内容，并原样念出图中最下方徽标里的那一串字符。最后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "WORKLOOM|验收|夹具|WORKLOOM"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-G1",
        "kind": "llm",
        "chain": "model-gateway",
        "model": "deepseek-v4.1-flash",
        "criticality": "P1",
        "title": "模型网关 · 结构化输出",
        "prompt": "只输出一行 JSON：{\"verdict\":\"ok\",\"risk\":\"low\",\"reason\":\"<20 字内>\"}。不要输出任何其他内容。",
        "expect": [
          "verdict"
        ]
      },
      {
        "id": "IMG-01",
        "kind": "image",
        "model": "seedream-5.0",
        "criticality": "P1",
        "images": 2,
        "title": "生图 · 产品海报（2 张）",
        "prompt": "WorkLoom 织元产品海报：深色背景 + 织线/光轨意象，中央标题「WORKLOOM」，下方小字「自主经营系统」。扁平、克制、无人物。",
        "expect": [
          "png"
        ],
        "minArtifacts": 1
      },
      {
        "id": "IMG-02",
        "kind": "image",
        "model": "seedream-5.0",
        "criticality": "P2",
        "images": 1,
        "title": "生图 · 应用图标",
        "prompt": "一个极简 App 图标：靛蓝底色，白色「织」字样的几何化线条，圆角方形，高对比。",
        "expect": [
          "png"
        ],
        "minArtifacts": 1
      },
      {
        "id": "VID-01",
        "kind": "video",
        "model": "seedance-2.5",
        "criticality": "P1",
        "durationSeconds": 12,
        "title": "生视频 · 12s 产品演示镜头",
        "prompt": "镜头缓慢推近一块悬浮的半透明数据看板，看板上有流动的光点与折线，背景深空蓝，运镜平稳，无人物，无文字。",
        "expect": [
          "mp4"
        ],
        "durationRange": [
          10,
          15
        ]
      },
      {
        "id": "VID-02",
        "kind": "video",
        "model": "seedance-2.5",
        "criticality": "P2",
        "durationSeconds": 12,
        "title": "生视频 · 12s 门店空镜",
        "prompt": "清晨的酒店大堂空镜：镜头从左向右匀速横移，暖色灯带、大理石地面反光，无人出现，画面干净。",
        "expect": [
          "mp4"
        ],
        "durationRange": [
          10,
          15
        ]
      },
      {
        "id": "PROD-01",
        "kind": "product",
        "criticality": "P0",
        "title": "研发需求澄清（经产品入口与线程事件读回）",
        "input": "suite.rdas.workloom-im：当前模糊研发需求有哪些需要先澄清的问题、承接岗位和风险？请用“需求”标注结论，列出缺失事实与待人工决定项，不实施任何改动。",
        "presetKey": "chief-pm",
        "workspaceSlug": "ai-pm-demo",
        "requireModel": true,
        "fixtureMarker": "suite.rdas.workloom-im",
        "residualDisclosure": "研发需求澄清验收会保留带 suite.rdas.workloom-im 标记的线程和事件；不会删除审计事件，需单独列入残留清单并排除 ADR/HIR 与经营指标。",
        "state_asserts": [
          {
            "event": {
              "action": "ask.answer",
              "field": "decision.after.text",
              "contains": "需求",
              "minLength": 12
            }
          }
        ]
      }
    ],
    "notes": "声明研发需求澄清的模型/产品任务。无受控身份、实际模型或结果回执时保持未验证；配置校验与 HTTP fixture 不构成生产通过。"
  },
